	       		// write(" keytemp and keyReprogValue  for j value %i beginning loop: %lx, %lx ",j, keytemp, keyReprogValue );    
    
    			if((keyMaxReprogValue - REP_RBA_CBB_AKEY_VALUE) < keytemp)
    			{
    	  		/* Rotate Right by 10 */
 	       			keyLowReprogValue = keyReprogValue & (0x000003FF);
 	    			keyUpperReprogValue = keyLowReprogValue << 22;
 	    			keyReprogValue = keyReprogValue >> 10;
 	    			keyReprogValue = keyReprogValue | keyUpperReprogValue;
       				keyReprogValue = keyReprogValue ^ REP_RBA_CBB_BKEY_VALUE;
    			}
    			else
    			{
 	    		/* Rotate Left by 13 */
 	    		    keyUpperReprogValue = keyReprogValue & (0xFFF80000);
 			        keyLowReprogValue   = keyUpperReprogValue >> 19;
 			    	keyReprogValue      = keyReprogValue << 13;
		 	    	keyReprogValue      = keyReprogValue | keyLowReprogValue;
		       		keyReprogValue      = keyReprogValue ^ REP_RBA_CBB_CKEY_VALUE;
		    	}
      		}
 
        	keyReprogValue = keyReprogValue - REP_RBA_CBB_DKEY_VALUE;

		  /* Key Algo end */
			    //write(" final  keyReprogValue %lx",keyReprogValue );    
  
        	resultarray[5] = (byte)(keyReprogValue & 0xff);
			resultarray[4] = (byte)((keyReprogValue >> 8) & 0xff);
			resultarray[3] = (byte)((keyReprogValue >> 16) & 0xff);
			resultarray[2] = (byte)((keyReprogValue >> 24) & 0xff);

           StartDiagService (SEEDNKEYRESP);
         
      break;

      case SEEDNKEYREPROGREQUESTWRITEKEY:
      
          
            getvalue(EnvRxData_CAN,puffer);
           
          // New Calculation of Reprog Key in BL for Release X060 onwards:
            
            resultarray[0] = 0x27 ;
            resultarray[1] = 0x12 ;

            for (i = 2; i <6 ; i++)
            {
            	resultarray_32[i]=puffer [i];
            }

			seedReprogValue = resultarray_32[5] |
							  (resultarray_32[4] << 8) |
							  (resultarray_32[3] << 16) |
							  (resultarray_32[2] << 24);

			keyReprogValue = seedReprogValue;

        
    
       		for(j = 0; j <7 ; j++)
        	{

            	keytemp = keyReprogValue ;
            	keyReprogValue = keyReprogValue + REP_RBA_CBB_AKEY_VALUE;
	       		// write(" keytemp and keyReprogValue  for j value %i beginning loop: %lx, %lx ",j, keytemp, keyReprogValue );    
    
    			if((keyMaxReprogValue - REP_RBA_CBB_AKEY_VALUE) < keytemp)
    			{
    	  		/* Rotate Right by 10 */
 	       			keyLowReprogValue = keyReprogValue & (0x000003FF);
 	    			keyUpperReprogValue = keyLowReprogValue << 22;
 	    			keyReprogValue = keyReprogValue >> 10;
 	    			keyReprogValue = keyReprogValue | keyUpperReprogValue;
       				keyReprogValue = keyReprogValue ^ REP_RBA_CBB_BKEY_VALUE;
    			}
    			else
    			{
 	    		/* Rotate Left by 13 */
 	    		    keyUpperReprogValue = keyReprogValue & (0xFFF80000);
 			        keyLowReprogValue   = keyUpperReprogValue >> 19;
 			    	keyReprogValue      = keyReprogValue << 13;
		 	    	keyReprogValue      = keyReprogValue | keyLowReprogValue;
		       		keyReprogValue      = keyReprogValue ^ REP_RBA_CBB_CKEY_VALUE;
		    	}
      		}
 
        	keyReprogValue = keyReprogValue - REP_RBA_CBB_DKEY_VALUE;

		  /* Key Algo end */
			    write(" final  keyReprogValue %lx",keyReprogValue );
                putValue( EnvWriteLoginKey, keyReprogValue );    
           
      break;

     case SEEDNKEYRBOLREQUESTWRITEKEY:
      
          
            getvalue(EnvRxData_CAN,pufferEOL);
      
            resultarray[0] = 0x27 ;
            resultarray[1] = 0x62 ;
            
            for (i = 2; i <6 ; i++)
            {
            	resultarray[i]=pufferEOL [i];
            }

			authKey = resultarray[5] |
							  (resultarray[4] << 8) |
							  (resultarray[3] << 16) |
							  (resultarray[2] << 24);    

               
          authKey = authKey & RBEOLPin; //It has been derived from the ASCII values of "Bosch Diagnostics for Driver Assistance"
          authKey = authKey | PMARequest; //Plant mode activation part request
      
          resultarray[5] = (byte)(authKey & 0xff);
    	  resultarray[4] = (byte)((authKey >> 8) & 0xff);
    	  resultarray[3] = (byte)((authKey >> 16) & 0xff);
    	  resultarray[2] = (byte)((authKey >> 24) & 0xff);

		  StartDiagService (SEEDNKEYRESP); 
           
      break;          
      
//For Service Package 01...
        case SEEDNKEYREQUESTUNLOCKONE: 
            //Calculate  key after receiving seed
         if (( RxDataBuffer[0] == 0x67 ) && ( RxDataBuffer[1] == 0x01 )&& (( RxDataBuffer[2] != 0x00 )|| ( RxDataBuffer[3] != 0x00 )))
         {
          

           getvalue(EnvRxData_CAN,puffer);
           
           byte_buf[0] = puffer[2];
           byte_buf[1] = puffer[3];
           write("puffer[2] %x and puffer [3] %x", puffer[2], puffer[3]);
           SeedInInit = (((puffer[2]<<8)|puffer[3])&0xFFFF);
          write("SeedInit=%x",SeedInInit);

          write("sk1 = %x",SK1);
          write("sk2 = %x",SK2);
          write("sk3 = %x",SK3);
           KeyInInt = ((SeedInInit + SK1)^((SeedInInit*SK2)%SK3));
           write("KeyInInt value %x", KeyInInt);
           
           KeyInByte[0] = KeyInInt>>8;
          write("KeyInInt byte[0]= %x", KeyInByte[0]);
           KeyInByte[1] = (KeyInInt&0xFF);
          write("KeyInInt byte[1]= %x", KeyInByte[1]);
           
           

    /*            //calculate the Key
                t_crc = 0xFF;
                byte_buf[0]=puffer[2];	byte_buf[1]=puffer[3];	byte_buf[2]=puffer[4];	byte_buf[3]=puffer[5];	
                CalculateCrc8 ();
                byte_buf[0] = t_crc;
                t_crc = 0xFF;

                CalculateCrc8 ();
                sec_key[0] = t_crc;
                t_crc = 0xFF;

                byte_buf[0]=puffer[2]; 	byte_buf[1]=sec_key[0];	
                CalculateCrc8 ();
                sec_key[1] = t_crc;
                t_crc = 0xFF;
						
            //crc8(&t_crc, seedlength, byte_buf);
            //key[1] = crc8(&t_crc, seedlength, byte_buf);;
			byte_buf[1]=puffer[3]; 	byte_buf[2]=sec_key[1];				
            CalculateCrc8 ();
            sec_key[2] = t_crc;
            t_crc = 0xFF;

        	byte_buf[2]=puffer[4]; 	byte_buf[3]=sec_key[2];	
            CalculateCrc8 ();
            sec_key[3] = t_crc;
            //t_crc = 0xFF;

                //result=puffer[2]*0x1000000+puffer[3]*0x10000+puffer[4]*0x100+puffer[5] + getValue(EnvDevLoginValue);
 */
            resultarrayTypeOne[3]=KeyInByte[1];
          write("resultarrayTypeOne[3]= %x", resultarrayTypeOne[3]);
            resultarrayTypeOne[2]=KeyInByte[0];
          write("resultarrayTypeOne[2]= %x", resultarrayTypeOne[2]);
			resultarrayTypeOne[1]=0x02;
          write("resultarrayTypeOne[1]= %x", resultarrayTypeOne[1]);
            resultarrayTypeOne[0]=0x27;
          write("resultarrayTypeOne[0]= %x", resultarrayTypeOne[0]);
            whichlogin=0;
          StartDiagService(SEEDNKEYRESP_TYPE1);

          }

      break;

      case SEEDNKEYREQUESTUNLOCKFOUR:

         write("Response %x%x%x%x%x%x%x",RxDataBuffer[0], RxDataBuffer[1], RxDataBuffer[2],RxDataBuffer[3],RxDataBuffer[4],RxDataBuffer[5],RxDataBuffer[6] );
            //Calculate  key after receiving seed
         if (( RxDataBuffer[0] == 0x67 ) && ( RxDataBuffer[1] == 0x41 )&& (( RxDataBuffer[2] != 0x00 )|| ( RxDataBuffer[3] != 0x00 )|| ( RxDataBuffer[4] != 0x00 )|| ( RxDataBuffer[5] != 0x00 )|| ( RxDataBuffer[6] != 0x00 )))
         {


           long Temp_u32 = 0x0;
           long Temp2_u32 = 0x0;
           getvalue(EnvRxData_CAN,puffer);

           byte_buf1[0] = puffer[2];
           byte_buf1[1] = puffer[3];
           byte_buf1[2] = puffer[4];
           byte_buf1[3] = puffer[5];
           write("puffer[2] %x and puffer [3] %x", puffer[2], puffer[3]);
           write("puffer[4] %x and puffer [5] %x", puffer[4], puffer[5]);

           //SeedInInit = ((puffer[2]<<24)|(puffer[3]<<16)|(puffer[4]<<8)|(puffer[5]<<0));
           SeedInInit = ((puffer[4]<<8)|(puffer[5]<<0));
           SeedInInit = (SeedInInit|(puffer[3]<<16));
           SeedInInit = (SeedInInit|(puffer[2]<<24));
           write("SeedInInit value %x", SeedInInit);
            //Keywk1 = (SeedInInit + SFC1);
           sum_carry = 0;

           sum_res[0] = byte_buf1[3] + SFC1[3];
           sum_carry = sum_res[0]>>8;
           sum_res[0] = sum_res[0]&0xFF;
           write("sum_res[0] value %x sum_carry value %x", sum_res[0],sum_carry);

           sum_res[1] = byte_buf1[2] + SFC1[2] + sum_carry;
           sum_carry = sum_res[1]>>8;
           sum_res[1] = sum_res[1]&0xFF;
           write("sum_res[1] value %x sum_carry value %x", sum_res[1],sum_carry);

           sum_res[2] = byte_buf1[1] + SFC1[1] + sum_carry;
           sum_carry = sum_res[2]>>8;
           sum_res[2] = sum_res[2]&0xFF;
           write("sum_res[2] value %x sum_carry value %x", sum_res[2],sum_carry);

           sum_res[3] = byte_buf1[0] + SFC1[0] + sum_carry;
           sum_carry = sum_res[3]>>8;
           sum_res[3] = sum_res[3]&0xFF;
           write("sum_res[3] value %x sum_carry value %x", sum_res[3],sum_carry);

           sum_res[4] = sum_carry;

           write("sum_res value %x%x%x%x%x", sum_res[4],sum_res[3],sum_res[2],sum_res[1],sum_res[0]);


           Temp_u32 = (sum_res[3]<<24)|(sum_res[2]<<16)|(sum_res[1]<<08)|(sum_res[0]);

          write("seed in hex %x",Temp_u32);
          /*Rotate left 3 times*/
           Temp2_u32 = (Temp_u32<<3)&0xFFFFFFF8;
           Temp_u32 = ((Temp_u32&0xE0000000)>>29)&0x7;
           //Temp2_u32 = Temp2_u32|(Temp_u32>>31);
           Temp_u32 = Temp2_u32|Temp_u32;
            
           sum_res[0] = (Temp_u32&0xFF);
           sum_res[1] = (Temp_u32&0xFF00)>>08;
           sum_res[2] = (Temp_u32&0xFF0000)>>16;
           sum_res[3] = (Temp_u32&0xFF000000)>>24;
           sum_res[4] = 0;

           write("Keywk1 value after 3 rol %x %x %x %x %x", sum_res[4],sum_res[3],sum_res[2],sum_res[1],sum_res[0]);

           Keywk1[0] = sum_res[0];
           Keywk1[1] = sum_res[1];
           Keywk1[2] = sum_res[2];
           Keywk1[3] = sum_res[3];
           Keywk1[4] = sum_res[4];
          
          /*Rotate left 3 times*/
           Temp2_u32 = (SeedInInit>>1)&0x7FFFFFFF;
           Temp_u32 = ((SeedInInit&0x00000001)<<31)&0x80000000;
           //Temp2_u32 = Temp2_u32|(Temp_u32>>31);
           Temp_u32 = Temp2_u32|Temp_u32;
          
           sum_res[0] = (Temp_u32&0xFF);
           sum_res[1] = (Temp_u32&0xFF00)>>08;
           sum_res[2] = (Temp_u32&0xFF0000)>>16;
           sum_res[3] = (Temp_u32&0xFF000000)>>24;
           sum_res[4] = 0;

           write("Keywk2 value after 3 rol %x %x %x %x %x", sum_res[4],sum_res[3],sum_res[2],sum_res[1],sum_res[0]);

           Keywk2[0] = sum_res[0];
           Keywk2[1] = sum_res[1];
           Keywk2[2] = sum_res[2];
           Keywk2[3] = sum_res[3];
           Keywk2[4] = sum_res[4];
          
           Temp_u32 = (SeedInInit>>16)&0xFFFF;
                    write("rnh %x",Temp_u32);
           Temp2_u32 = SeedInInit&0xFFFF;
             write("rnl %x",Temp2_u32);
           Temp_u32 = Temp_u32*Temp2_u32;
          
          write("multiple of rnh and rnl %x",Temp_u32);
          
           sum_res[0] = (Temp_u32&0xFF);
           sum_res[1] = (Temp_u32&0xFF00)>>08;
           sum_res[2] = (Temp_u32&0xFF0000)>>16;
           sum_res[3] = (Temp_u32&0xFF000000)>>24;
           sum_res[4] = 0;
          
           write("Keywk3 value after 3 rol %x%x%x%x%x", sum_res[4],sum_res[3],sum_res[2],sum_res[1],sum_res[0]);

          
           Keywk3[0] = sum_res[0];
           Keywk3[1] = sum_res[1];
           Keywk3[2] = sum_res[2];
           Keywk3[3] = sum_res[3];
           Keywk3[4] = sum_res[4];
          
           sum_res[0] =  Keywk1[0] ^  Keywk2[0] ^ Keywk3[0];
           sum_res[1] =  Keywk1[1] ^  Keywk2[1] ^ Keywk3[1];
           sum_res[2] =  Keywk1[2] ^  Keywk2[2] ^ Keywk3[2];
           sum_res[3] =  Keywk1[3] ^  Keywk2[3] ^ Keywk3[3];

           write("Keywk xored output value after 3 rol %x%x%x%x%x", sum_res[4],sum_res[3],sum_res[2],sum_res[1],sum_res[0]);

           sum_carry = 0;

           sum_res[0] = sum_res[0] + 0x14;
           sum_carry = sum_res[0]>>8;
           sum_res[0] = sum_res[0]&0xFF;
           write("sum_res[0] value %x sum_carry value %x", sum_res[0],sum_carry);

           sum_res[1] = sum_res[1] + 0x37 + sum_carry;
           sum_carry = sum_res[1]>>8;
           sum_res[1] = sum_res[1]&0xFF;
           write("sum_res[1] value %x sum_carry value %x", sum_res[1],sum_carry);

           sum_res[2] = sum_res[2] + 0x70 + sum_carry;
           sum_carry = sum_res[2]>>8;
           sum_res[2] = sum_res[2]&0xFF;
           write("sum_res[2] value %x sum_carry value %x", sum_res[2],sum_carry);

           sum_res[3] = sum_res[3] + 0x00 + sum_carry;
           sum_carry = sum_res[3]>>8;
           sum_res[3] = sum_res[3]&0xFF;
           write("sum_res[3] value %x sum_carry value %x", sum_res[3],sum_carry);

           sum_res[4] = sum_carry;

           write("sum_res value %x%x%x%x%x", sum_res[4],sum_res[3],sum_res[2],sum_res[1],sum_res[0]);          
          

            resultarrayTypeFour[6]= 0xEA;  
            //resultarrayTypeFour[2]=(KC4>>24)&(0xFF);
            //resultarrayTypeFour[3]=(KC4>>16)&(0xFF);
            //resultarrayTypeFour[4]=(KC4>>8)&(0xFF);
            //resultarrayTypeFour[5]=(KC4>>0)&(0xFF);
            resultarrayTypeFour[2]=sum_res[3];
            resultarrayTypeFour[3]=sum_res[2];
            resultarrayTypeFour[4]=sum_res[1];
            resultarrayTypeFour[5]=sum_res[0];
			resultarrayTypeFour[1]=0x42;
            resultarrayTypeFour[0]=0x27;
            whichlogin=0;
          StartDiagService(SEEDNKEYRESP_TYPE4);

