	break;
	
	case 0x5BE100:
        putValue (EnvDtcName_Display, "DTC_BCAN_WIPER_FAILURE");
		putValue (EnvMidName, "C_MID_FAULT_BCAN_WIPER_FAILURE_N");
	break;
	
	case 0x5BDB00:
        putValue (EnvDtcName_Display, "DTC_BRAKE_SWITCH_ABNORMAL");
		putValue (EnvMidName, "C_MID_FAULT_BRAKE_SWITCH_ABNORMAL_N");
	break;
	
	case 0xAA6054:
