      break;
      
      case SEEDNKEYREQUESTUNLOCKFIVE: 
            //Calculate  key after receiving seed
         if (( RxDataBuffer[0] == 0x67 ) && ( RxDataBuffer[1] == 0x07 )&& (( RxDataBuffer[2] != 0x00 )|| ( RxDataBuffer[3] != 0x00 )||( RxDataBuffer[4] != 0x00 )||( RxDataBuffer[5] != 0x00 )))
         {
