			}
    
    }
    write("%s",pufferStr);
    substr_cpy(Seed,pufferStr,6,-1,elcount(Seed));
    
    if(securityRespBuffer[0] != 0x7F)
    {
      putValue(Env_Security_SeedOutput,Seed);
    }
    
    toUpper(Seed,Seed,elcount(Seed));
          
    for(i=0;i<100;i++)
    {
      if(strncmp(seedListHONDA[i],Seed, elcount(Seed))==0)
      {
        break;
      }
      else if(100== i+1)
      {
        write("The Security XML doesnt have the required seed - key pair ");
        
        i = -1;
        break;
      }
    }
    
    if(i!=-1)
    {
    sendKey[0]=0x27;
    sendKey[1]=SeednKeyHONDAEOLRequest[1]+1;
    k=2;  
    
    strncpy(temp, "0x",3);
    j=0;
    gTxlength = (strlen(keyListHONDA[i])/2)+2;
    
    while(j<strlen(keyListHONDA[i]))
    {
      temp[2]=keyListHONDA[i][j];
      temp[3]=keyListHONDA[i][j+1];
      temp[4]=0;
      sendKey[k]=atol(temp);
      k++;
      j+=2;
    }
    sendKey[k]='\0';    
    StartDiagService( SEEDNKEYHONDARESP);
    }
     break;
        
      case SEEDNKEYREQUEST:
      
          
            getvalue(EnvRxData_CAN,puffer);
           
          // New Calculation of Reprog Key in BL for Release X060 onwards:
            
            resultarray[0] = 0x27 ;
            resultarray[1] = SeednKeyFBLRequest[1] + 1;

            for (i = 2; i <6 ; i++)
            {
            	resultarray_32[i]=puffer [i];
            }

			seedReprogValue = resultarray_32[5] |
							  (resultarray_32[4] << 8) |
							  (resultarray_32[3] << 16) |
							  (resultarray_32[2] << 24);

			keyReprogValue = seedReprogValue;

        
    
       		for(j = 0; j <7 ; j++)
        	{

            	keytemp = keyReprogValue ;
            	keyReprogValue = keyReprogValue + REP_RBA_CBB_AKEY_VALUE;
	       		// write(" keytemp and keyReprogValue  for j value %i beginning loop: %lx, %lx ",j, keytemp, keyReprogValue );    
    
    			if((keyMaxReprogValue - REP_RBA_CBB_AKEY_VALUE) < keytemp)
    			{
    	  		/* Rotate Right by 10 */
 	       			keyLowReprogValue = keyReprogValue & (0x000003FF);
 	    			keyUpperReprogValue = keyLowReprogValue << 22;
 	    			keyReprogValue = keyReprogValue >> 10;
 	    			keyReprogValue = keyReprogValue | keyUpperReprogValue;
       				keyReprogValue = keyReprogValue ^ REP_RBA_CBB_BKEY_VALUE;
    			}
    			else
    			{
 	    		/* Rotate Left by 13 */
 	    		    keyUpperReprogValue = keyReprogValue & (0xFFF80000);
 			        keyLowReprogValue   = keyUpperReprogValue >> 19;
 			    	keyReprogValue      = keyReprogValue << 13;
		 	    	keyReprogValue      = keyReprogValue | keyLowReprogValue;
		       		keyReprogValue      = keyReprogValue ^ REP_RBA_CBB_CKEY_VALUE;
		    	}
      		}
 
        	keyReprogValue = keyReprogValue - REP_RBA_CBB_DKEY_VALUE;

		  /* Key Algo end */
			    //write(" final  keyReprogValue %lx",keyReprogValue );    
  
        	resultarray[5] = (byte)(keyReprogValue & 0xff);
			resultarray[4] = (byte)((keyReprogValue >> 8) & 0xff);
			resultarray[3] = (byte)((keyReprogValue >> 16) & 0xff);
			resultarray[2] = (byte)((keyReprogValue >> 24) & 0xff);

           StartDiagService (SEEDNKEYRESP);
         
      break;
      
      case READ_DTC_BY_ST_RBEOL:  //***********************************RBEOL******************************************************
        if ( gRxDataBuffer[0] == 0x59 )
         {
            gRxBufferIndex  = 3;
            gNrOfReadDTC    = (Length - 3)/4;  
            DtcNr        = 1; 
            for (i = 0; i < gNrOfReadDTC; i++)
            {
                  gerrorDTC[DtcNr]      = (dword)gRxDataBuffer[gRxBufferIndex++] << 16;
                  gerrorDTC[DtcNr]      += (dword)gRxDataBuffer[gRxBufferIndex++] << 8;
                  gerrorDTC[DtcNr]      += (dword)gRxDataBuffer[gRxBufferIndex++]; 
                  gerrorStatus[DtcNr++] = gRxDataBuffer[gRxBufferIndex++];
			   
            }
            if ( (gNrOfReadDTC == 0) )
            {
                   putValue (EnvReqStatus_CAN, "No DTCs");
            }else{
                   putValue (EnvReqStatus_CAN, "All DTCs received");
            }

               gCurrentDTC = 1;
               ShowDTCs();
               
            
            }
    break;
            
              
   }

}  



//Ends here 
///////////////////////////////////////////////////////////////////////
void StartDiagService( byte ServiceId )           //Can be used for GEN3 sec unlock mechanism
{ 
    int i;
    byte buffer[1];
    long switchEWBsValue = 0x00;

   CurrentDiagServ = ServiceId;
    
         putValue (EnvReqStatus_CAN, "...");
         putValue (EnvRespTime_CAN, 0.0);
    

   //Diag Switch
   switch ( ServiceId )
   {
        case TESTER_PRESENT_OFF:
            //msgDiagRequest.byte(0) = 0x02;
            //msgDiagRequest.byte(1) = 0x10;
            //msgDiagRequest.byte(2) = 0x01;   //Default session

            cancelTimer (TesterPresentTimer);
          //  ReqDiagMsgGlobal.CAN = SEND_CAN;        

          //output (msgDiagRequest);
      
      //      putValue (EnvReqStatus_CAN, "OK");
        break;

        case TESTER_PRESENT_ON:
            //msgDiagRequest.byte(0) = 0x02;
            //msgDiagRequest.byte(1) = 0x10;
            //msgDiagRequest.byte(2) = 0x03;	//Extended diag session
            


            cancelTimer (TesterPresentTimer);
            setTimer (TesterPresentTimer, FirstTesterPresentTime);

            //msgDiagRequest.CAN = SEND_CAN;        

         // output (msgDiagRequest);
      
       //     putValue (EnvReqStatus_CAN, "OK");

        break;

      
      case DIAG_SESSION_ON:
           TxDataBuffer[0] = 0x10;
            TxDataBuffer[1] = 0x03;	//Extended diag session
            
            TxLength = 2;  
            TransmitTxBuffer();
            
      break;
      
      case ENGINEERING_SESSION_ON:
           TxDataBuffer[0] = 0x10;
            TxDataBuffer[1] = 0x4f;	//Engineering diag session
            
            TxLength = 2;  
            TransmitTxBuffer();
            
      break;

      
      
      case READ_DTC_BY_ST: 

         TxDataBuffer[0] = 0x19;
         TxDataBuffer[1] = 0x02;
         TxDataBuffer[2] = 0x09;  
        //  SId = TxDataBuffer[0];
         TxLength = 3; 
         TransmitTxBuffer();
         

      break;      


      case READ_DTC_PASS:

         TxDataBuffer[0] = 0x19;
         TxDataBuffer[1] = 0x02;
         TxDataBuffer[2] = 0x08;  
        // SId = TxDataBuffer[0];
         TxLength = 3;  
         TransmitTxBuffer();
      break;



      case CLEAR_DTC: 
         TxDataBuffer[0] = 0x14;
         TxDataBuffer[1] = 0xFF;  
         TxDataBuffer[2] = 0xFF;
         TxDataBuffer[3] = 0xFF;   
         // SId = TxDataBuffer[0];
         TxLength = 4;
         TransmitTxBuffer();
      break;


      case DIRECT_RQ: 
      TxLength = DirectTxDataLen;
         TransmitTxBuffer();
         /*if(Radar_start==1)
        {
          Radar_start=0;
          putValue(Env_RADAR_Info,1);
          
        }
        else
        {
         TxLength = DirectTxDataLen;
         TransmitTxBuffer();
        }*/
      break;

      case READ_HIST_DTC_BY_ST: 
         TxDataBuffer[0] = 0x19;
         TxDataBuffer[1] = 0x02;
         TxDataBuffer[2] = 0x08;  //passive
 //        TxDataBuffer[2] = 0x10;  //untested
   //    TxDataBuffer[3] = 0x00;
         
         TxLength = 3;  //4
         TransmitTxBuffer();
      break;  
      case P_MODE_ACT_P1:
      
        //1) Send part1 request "80 B5 28 C3 1E FD"
        TxDataBuffer[0] = 0x80;
        TxDataBuffer[1] = 0xB5;
        TxDataBuffer[2] = 0x28;  
        TxDataBuffer[3] = 0xC3;  
        TxDataBuffer[4] = 0x1E;  
        TxDataBuffer[5] = 0xFD;  
       
        TxLength = 6; 
        TransmitTxBuffer();
        
      break;  
      
      case P_MODE_ACT_P2:
      
        //2) Send part2 request "80 B5 7C 68"
        TxDataBuffer[0] = 0x80;
        TxDataBuffer[1] = 0xB5;
        TxDataBuffer[2] = 0x7C;  
        TxDataBuffer[3] = 0x68;  
        
        TxLength = 4; 
        TransmitTxBuffer();
        
      break; 

    case FINGERPRINT: 
         
        putValue(EnvTxData_1,Fingerprint);
        DirectTxDataLen = getValue( EnvTxData_1, TxDataBuffer );
        TxLength = DirectTxDataLen;
        TransmitTxBuffer();
        setTimer(ProgDate,200);
    break; 

    
    case PROGDATE: 
    
        putValue(EnvTxData_1,ProgrammingDate);
        DirectTxDataLen = getValue( EnvTxData_1, TxDataBuffer );
        TxLength = DirectTxDataLen;
        TransmitTxBuffer();
         switch ( whichlogin)
         {
             case 1:
             case 2:
                setTimer(SeednKeyReq,200);
             break;
             case 5:
             case 6:
                setTimer ( MinicodeReq, 200);
             break;
        }

    break; 

    case SEEDNKEYREQUEST: 
         
        putValue(EnvTxData_1,SeednKeyRequest);
        DirectTxDataLen = getValue( EnvTxData_1, TxDataBuffer );
        TxLength = DirectTxDataLen;
        TransmitTxBuffer();
       
    break; 

            
//For GEN3 Unlock:
       case SEEDNKEYHONDAREQUEST: 
         
          putValue(EnvTxData_1,SeednKeyHONDAEOLRequest);
          DirectTxDataLen = getValue( EnvTxData_1, TxDataBuffer );
          TxLength = DirectTxDataLen;
          TransmitTxBuffer();
       
      break; 
      
      case SEEDNKEYHONDAEOLREQUEST: 
         
          putValue(EnvTxData_1,SeednKeyHONDAEOLRequest);
          DirectTxDataLen = getValue( EnvTxData_1, TxDataBuffer );
          TxLength = DirectTxDataLen;
          TransmitTxBuffer();
       
      break; 
         case SEEDNKEYFBLREQUEST: 
         
          putValue(EnvTxData_1,SeednKeyFBLRequest);
          DirectTxDataLen = getValue( EnvTxData_1, TxDataBuffer );
          TxLength = DirectTxDataLen;
          TransmitTxBuffer();
       
      break; 
        
      case SEEDNKEYFBLDYNAMICREQUEST:
        
          putValue(EnvTxData_1,SeednKeyFBLRequest);
          DirectTxDataLen = getValue( EnvTxData_1, TxDataBuffer );
          TxLength = DirectTxDataLen;
          TransmitTxBuffer();
          break;
        
      case SEEDNKEYHONDADYNAMICREQUEST:
        
          putValue(EnvTxData_1,SeednKeyHONDAEOLRequest);
          DirectTxDataLen = getValue( EnvTxData_1, TxDataBuffer );
          TxLength = DirectTxDataLen;
          TransmitTxBuffer();
          break;
            
          case SEEDNKEYRBEOLRESP: 
            putValue(EnvTxData_1,resultarra);
            DirectTxDataLen = getValue( EnvTxData_1, TxDataBuffer );
            TxLength = DirectTxDataLen;
            TransmitTxBuffer();
           
    break;
     

    case SEEDNKEYHONDARESP: 
        
            putValue(EnvTxData_1,sendKey);
            DirectTxDataLen = getValue( EnvTxData_1, TxDataBuffer );
            TransmitTxBuffer();
           
    break;     
          
    case READ_DTC_BY_ST_RBEOL: // Trasmitting Read DTC request in RBEOL****************************************************
           TxDataBuffer[0] = 0x19;
           TxDataBuffer[1] = 0x02;
           TxDataBuffer[2] = 0xFF;  
           TxLength = 3; 
           TransmitTxBuffer();
          break;      
            
            
            
 /////////////////////////////////////////////////////           
    case SEEDNKEYREPROGREQUEST: 
         
        putValue(EnvTxData_1,SeednKeyReprogRequest);
        DirectTxDataLen = getValue( EnvTxData_1, TxDataBuffer );
        TxLength = DirectTxDataLen;
        TransmitTxBuffer();
      
    break;

    case SEEDNKEYRBEOLREQUEST: 
         
        putValue(EnvTxData_1,SeednKeyRBEOLRequest);
        DirectTxDataLen = getValue( EnvTxData_1, TxDataBuffer );
        TxLength = DirectTxDataLen;
        TransmitTxBuffer();
      
    break;

   
    
    case SEEDNKEYREPROGREQUESTWRITEKEY: 
         
        putValue(EnvTxData_1,SeednKeyReprogRequest);
        DirectTxDataLen = getValue( EnvTxData_1, TxDataBuffer );
        TxLength = DirectTxDataLen;
        TransmitTxBuffer();
      
    break; 
  
     case  MINICODEREQUEST : 
        if (whichlogin == 5)   // Plant
        {
            MinicodeRequest[1]= 0x03; 
      
        }else {
             MinicodeRequest[1]= 0x21;  // Development
        }
        putValue(EnvTxData_1,MinicodeRequest);
        DirectTxDataLen = getValue( EnvTxData_1, TxDataBuffer );
        TxLength = DirectTxDataLen;
        TransmitTxBuffer();
         
     break; 


     //  case SEEDRBEOLREQUEST: 
         
       //    TxDataBuffer[0] = 0x23;
       //    TxDataBuffer[1] = 0x88;
       //    TxDataBuffer[2] = 0x01;  
       //    TxDataBuffer[3] = 0x00;  
       //    TxDataBuffer[4] = 0x00;
         
       //  TxLength = 5;  //4
      //   TransmitTxBuffer();
        
    //  break; 
     
         case SEEDNKEYRESP: 
            putValue(EnvTxData_1,resultarray);
            DirectTxDataLen = getValue( EnvTxData_1, TxDataBuffer );
            TxLength = DirectTxDataLen;
            TransmitTxBuffer();
           
         break; 

         case SEEDNKEYRESP_TYPE1: 
            putValue(EnvTxData_1,resultarrayTypeOne);
            DirectTxDataLen = getValue( EnvTxData_1, TxDataBuffer );
            TxLength = DirectTxDataLen;
            TransmitTxBuffer();
           
         break; 

        case SEEDNKEYRESP_TYPE4: 
            putValue(EnvTxData_1,resultarrayTypeFour);
            DirectTxDataLen = getValue( EnvTxData_1, TxDataBuffer );
            TxLength = DirectTxDataLen;
            TransmitTxBuffer();
           
        break;
        
        case SEEDNKEYRESP_TYPE5: 
        
            putValue(EnvTxData_1,resultarrayTypeFive);
            DirectTxDataLen = getValue( EnvTxData_1, TxDataBuffer );
            TxLength = DirectTxDataLen;
            TransmitTxBuffer();
           
        break;

        case  READ_EWB_ACT:

         TxDataBuffer[0] = 0x22;
         TxDataBuffer[1] = 0x05;
         TxDataBuffer[2] = EWB_VZE_ID; 
         TxDataBuffer[3] = 0x05;
         TxDataBuffer[4] = EWB_VZF_ID; 
         TxDataBuffer[5] = 0x05;
         TxDataBuffer[6] = EWB_EHR_ID;
         TxDataBuffer[7] = 0x05;
         TxDataBuffer[8] = EWB_HCA_ID;
         TxDataBuffer[9] = 0x05;
         TxDataBuffer[10] = EWB_MOD_ID;
         TxDataBuffer[11] = 0x05;
         TxDataBuffer[12] = EWB_FLA_ID;
         TxDataBuffer[13] = 0x09; //MI
         TxDataBuffer[14] = EWBs_ID; //MI
    
         TxLength = 15;  
         TransmitTxBuffer();
        break;  
 

        case  READ_DEACT_FUNC :  
         TxDataBuffer[0] = 0x22;
         TxDataBuffer[1] =  0x05;
         TxDataBuffer[2] = DEACT_FLA_ID; 
         TxDataBuffer[3] =  0x05;
         TxDataBuffer[4] = DEACT_VZE_ID; 
         TxDataBuffer[5] = 0x05;
         TxDataBuffer[6] = DEACT_CCP_ID;
         TxLength = 7;  
         TransmitTxBuffer();
  break;




   case  PRE_WRITE : 
        SetControlForeColor("Anpassungen", "PrepareWriteControl", MakeRGB(0,192,0));
            
        putvalue(EnvDirectSend,"104F");
     
        putvalue(EnvLogIn106A3,1);
        // Set tester present 
        putvalue(EnvTesterPresentOnOff, 1);
      
   break;

      case  PRE_WRITE_MINICODE : 
        SetControlForeColor("Anpassungen", "PrepareWriteControlMinicode", MakeRGB(0,192,0));
            
        putvalue(EnvDirectSend,"104F");
     
        putvalue(EnvMinicode_Dev,1);
        // Set tester present 
        putvalue(EnvTesterPresentOnOff, 1);
      
   break;

 

     case  READ_MASK_FAULT_CLASS:
 
         TxDataBuffer[0] = 0x22;
         TxDataBuffer[1] =  0x05;
         TxDataBuffer[2] = MASK_FAULT_CLASS_ID; 
         TxLength = 3;  
         TransmitTxBuffer();
        
    break;

     
       case   READ_MASK_ERR_RCTN:
 
         TxDataBuffer[0] = 0x22;
         TxDataBuffer[1] =  0x05;
         TxDataBuffer[2] = MASK_ERR_RCTN_ID; 
         TxLength = 3;  
         TransmitTxBuffer();
        
    break;


      case  READ_BAP_PERS:
 
         TxDataBuffer[0] = 0x22;
         TxDataBuffer[1] =  0x09;
         TxDataBuffer[2] = BAP_PERS_ID;  
         TxLength = 3;  
         TransmitTxBuffer();
        
    break;
 

      case READ_V_THRESHOLD_MAINBEAM_ON:
 
         TxDataBuffer[0] = 0x22;
         TxDataBuffer[1] =  0x3B;
         TxDataBuffer[2] = V_THRESHOLD_MAINBEAM_ON_ID;
         TxLength = 3;  
         TransmitTxBuffer();
        
    break;
  

      case READ_V_THRESHOLD_MAINBEAM_OFF:
 
         TxDataBuffer[0] = 0x22;
         TxDataBuffer[1] =  0x3B;
         TxDataBuffer[2] = V_THRESHOLD_MAINBEAM_OFF_ID;
         TxLength = 3;  
         TransmitTxBuffer();
        
    break;

    case SEEDNKEYREQUESTUNLOCKONE: 
                
        putValue(EnvTxData_1,SeednKeyTypeOne);
        DirectTxDataLen = getValue( EnvTxData_1, TxDataBuffer );
        TxLength = DirectTxDataLen;
        TransmitTxBuffer();
      
    break;
    case SEEDNKEYREQUESTUNLOCKFOUR: 
                
        putValue(EnvTxData_1,SeednKeyTypeFour);
        DirectTxDataLen = getValue( EnvTxData_1, TxDataBuffer );
        TxLength = DirectTxDataLen;
        TransmitTxBuffer();
      
    break;
    
    case SEEDNKEYREQUESTUNLOCKFIVE: 
                
        putValue(EnvTxData_1,SeednKeyTypeFive);
        DirectTxDataLen = getValue( EnvTxData_1, TxDataBuffer );
        TxLength = DirectTxDataLen;
        TransmitTxBuffer();
      
    break;

}


}   

CharArray2Byte(char convertable_array[])
{

    int i;
    char c1,c2;
    int strIndex;
    
    strIndex = 0;
    
    for (i = 0; i < elcount(RqTxStringData); i++)
      {
          RqTxStringData[i] = 0;
      } 
   
    for (i = 0; i < elcount(convertable_array); i++)
     {
      RqTxStringData[i] = convertable_array[i];     //RqTxStringData is a global variable
     }

    ByteSize = 0;  //ByteSize is a global variable
    for (i = 0; i < (strlen(RqTxStringData)/2); i++)
    {
        strIndex = i * 2;
         
        c1 = RqTxStringData[strIndex];
        c2 = RqTxStringData[strIndex + 1];
//        write ("Here is c1: %c and c2: %c", c1, c2);
        RqTxData[i] = char2byte(c1, 16) + char2byte(c2, 1);     // RqTxData is a global variable
        ByteSize++;
    }
    SID = RqTxData[0];
    write("SID chararray %x",SID);
    write("RqTxData[0] inside chararray %x",RqTxData[0]);
    write("convertable_array %s  %d",convertable_array,elcount(convertable_array));
}

byte char2byte (char c, int factor)
{
    switch(c){
    case 'F':
    case 'f': return 15 * factor;
    case 'E':
    case 'e': return 14 * factor;
    case 'D':
    case 'd': return 13 * factor;
    case 'C':
    case 'c': return 12 * factor;
    case 'B':
    case 'b': return 11 * factor;
    case 'A':
    case 'a': return 10 * factor;
    case '9': return 9 * factor;
    case '8': return 8 * factor;
    case '7': return 7 * factor;
    case '6': return 6 * factor;
    case '5': return 5 * factor;
    case '4': return 4 * factor;
    case '3': return 3 * factor;
    case '2': return 2 * factor;
    case '1': return 1 * factor;
    }
    return 0;
}


void TransmitTxBuffer (void)
{ 	

    /*switch (getvalue(EnvDiagPhyTxCANIDs))
    {
        case 0x18DAB5F1: 
    
        // Physical CanID 1
        ConfigTP(0x18DAB5F1, 0x18DAF1B5);
    
        break;

        case 0x18DAB5F2: 

        // Physical CanID 2
        ConfigTP(0x18DAB5F2, 0x18DAF2B5);
        break;


        case 0x18DAB5F3: 

        // Physical CanID 3
        ConfigTP(0x18DAB5F3, 0x18DAF3B5);
        break;


    
        case 0x18DAB5F4: 

        // Physical CanID 4
        ConfigTP(0x18DAB5F4, 0x18DAF4B5);
        break;



        case 0x18DAB5F5: 

        // Physical CanID 5
        ConfigTP(0x18DAB5F5, 0x18DAF5B5);
        break;

    

        case 0x18DAB5F6: 

        // Physical CanID 6
        ConfigTP(0x18DAB5F6, 0x18DAF6B5);
        break;

    
        case 0x18DAB5F7: 

        // Physical CanID 7
        ConfigTP(0x18DAB5F7, 0x18DAF7B5);
        break;


    
        case 0x18DAB5F8: 

        // Physical CanID 8
        ConfigTP(0x18DAB5F8, 0x18DAF8B5);
        break;

    

        case 0x18DAB5F9: 

        // Physical CanID 9
        ConfigTP(0x18DAB5F9, 0x18DAF9B5);
        break;




        case 0x18DAB5FA: 

        // Physical CanID 10
        ConfigTP(0x18DAB5FA, 0x18DAFAB5);
        break;



        case 0x18DAB5FB: 

        // Physical CanID 11
        ConfigTP(0x18DAB5FB, 0x18DAFBB5);
        break;



        case 0x18DAB5FC: 

        // Physical CanID 12
        ConfigTP(0x18DAB5FC, 0x18DAFCB5);
        break;



        case 0x18DAB5FD: 

        // Physical CanID 13
        ConfigTP(0x18DAB5FD, 0x18DAFDB5);
        break;



    }*/

	// OSEK TP supports up to 4095 bytes per transmission
  //	SId = TxDataBuffer[0];
	if (TxLength >= 4096)
		TxLength = 4095;
	

	//Fault Injections
	if (getvalue(EnvCFDoubleDelay)!=0)
		{
			OSEKTL_FI_DoubleCF (getvalue(EnvCFNr), getvalue(EnvCFDoubleDelay));
			write ("FI Fault Double CF"); 
		}


	if (getvalue(EnvCFDrop)==1)
	{
			OSEKTL_FI_DropCF(getvalue(EnvCFNr));
			write ("FI Fault Drop CF Nr %i",getvalue(EnvCFNr));
	}

	
 

	if (getvalue(EnvCFDelay)!=0)
	{
		OSEKTL_FI_DelayCF(getvalue(EnvCFNr),getvalue(EnvCFDelay));
	}
    
	// Empty Value for EnvRxData to avoid showing old values

    	putValue( EnvRxData_CAN,emptyString,0);
        putValue(EnvRxDataLen_CAN,0);
  write("MVBuffer transmit buff:%s",MVbuffer);
  putvalue (EnvDirectReceive,MVbuffer); // delete old value from receive 
  
 
	    OSEKTL_DataReq( TxDataBuffer, TxLength ); 
		
		putValue( EnvTxData_1, TxDataBuffer, TxLength );



	SId = TxDataBuffer[0];

}

OSEKTL_DataCon(long status)
{
	if (status != 0) 
	{
		RespTime = ( (float) timeNow() * (-1.0) );	
       	
	}
	else
	{
		write("Tx error, status is %d", status);
	}
}



OSEKTL_DataInd( long rxCount )
{
  // write("in dataind"); 
    int i;
    char	MVbuffer[200000] = "";
    char	MVbuffer2[200000] = "";
    char buffer2[200000]="0";
    
    strncpy(buffer2, "0", 6);
	  strncpy(MVbuffer2, "",6);
	  strncpy(MVbuffer, "",6);   
     write("in dataind"); 
	/* Get received data */
   
	OSEKTL_GetRxData( RxDataBuffer, elcount(RxDataBuffer) );
 ///////////////////////////////NA RBS////////////////// 
  write("RxDataBuffer[0] %x RxDataBuffer[1] %x RxDataBuffer[2] %x RxDataBuffer[3] %x",RxDataBuffer[0],RxDataBuffer[1],RxDataBuffer[2],RxDataBuffer[3]);
 
 if ((RxDataBuffer[0]==0x62)&(RxDataBuffer[1]==0xA8)&(RxDataBuffer[2]==0xC2)&(env_SW_Set==1))
  {
    int temp = 0;
   
//   getvalue(EnvDirectReceive,a8c2buffer);
   //write("A8C2 data:%s",a8c2buffer);
    putValue (EnvDiagSession, 0);
    
     for (temp=0;temp<9;temp++)
        {
          SWbuildversion[temp]= RxDataBuffer[temp+3];
        }
        for (temp=0;temp<5;temp++)
        {
          VariantName[temp]= RxDataBuffer[temp+12];
        }
        SeriesPKG[0] = RxDataBuffer[60];
       
        ////write("a8c2buffer[0]:%c",a8c2buffer[0]);
    putValue(EnvReadSoftwareVersion,SWbuildversion);
        //write("SWbuildversion data:%s",SWbuildversion);
    putValue(EnvReadVariantName,VariantName);
         //write("VariantName data:%s",VariantName);
    putValue(EnvReadSeriesPKG,SeriesPKG);
         //write("SeriesPKG data:%s",SeriesPKG);
        if(RxDataBuffer[75]== 0x01)
        {
          putValue(Env_Development_mode,"Enabled");
        }
        else
        {
          putValue(Env_Development_mode,"Disabled");
          
        }
        ReqDiagMsgGlobal1.dlc = 0x08;
                 ReqDiagMsgGlobal1.byte(0) = 0x02;
                 ReqDiagMsgGlobal1.byte(1) = 0x10;
                 ReqDiagMsgGlobal1.byte(2) = 0x01;
                 ReqDiagMsgGlobal1.byte(3) = 0x55;
                 ReqDiagMsgGlobal1.byte(4) = 0x55;
                 ReqDiagMsgGlobal1.byte(5) = 0x55;
                 ReqDiagMsgGlobal1.byte(6) = 0x55;
                 ReqDiagMsgGlobal1.byte(7) = 0x55;
                 output (ReqDiagMsgGlobal1);
        env_SW_Set = 0;
  }

  if((RxDataBuffer[0]==0x7F)&(RxDataBuffer[1]==0x22)&(RxDataBuffer[2]==0x31) )
  {
     //write(",fdjgbfdgkb f");
  //putValue(Env_RADAR_Info,1);
    
  
  }
  
 
    if((RxDataBuffer[0]==0x63)&&((RxDataBuffer[1]==0x01)||(RxDataBuffer[1]==0x00)))
  {
        
        write("flag=%d\n",flag);
    if(flag==1)
    { //Considered when u restart the Cfg.. to update the radar with the last variant coded values
		    putvalue(EnvDirectSend,"1001");
        flag=0;
    }
    if(RxDataBuffer[2] == 0x52 || RxDataBuffer[2] == 0x54)
    { //For the radar message update 
    
//       putvalue(E_pric_Bosch_Radar_RADAR_VARIANT_INFO_VARIANT_INFO_1_Rv,RxDataBuffer[2]);
//       putvalue(E_pric_Bosch_Radar_RADAR_VARIANT_INFO_VARIANT_INFO_2_Rv,RxDataBuffer[3]);
//       putvalue(E_pric_Bosch_Radar_RADAR_VARIANT_INFO_VARIANT_INFO_3_Rv,RxDataBuffer[4]);
//       putvalue(E_pric_Bosch_Radar_RADAR_VARIANT_INFO_VARIANT_INFO_4_Rv,RxDataBuffer[5]);
//       putvalue(E_pric_Bosch_Radar_RADAR_VARIANT_INFO_VARIANT_INFO_5_Rv,RxDataBuffer[6]);
        OSEKTL_SetUseFC(1);
      }  
   } 
  
  
  if((RxDataBuffer[0]==0x62)&(RxDataBuffer[1]==0x48)&(RxDataBuffer[2]==0xf5)&(RxDataBuffer[3]==0x01))
  {
//        putvalue(E_pric_Bosch_Radar_RADAR_VARIANT_INFO_VARIANT_INFO_1_Rv,RxDataBuffer[4]);
//        putvalue(E_pric_Bosch_Radar_RADAR_VARIANT_INFO_VARIANT_INFO_2_Rv,RxDataBuffer[5]);
//        putvalue(E_pric_Bosch_Radar_RADAR_VARIANT_INFO_VARIANT_INFO_3_Rv,RxDataBuffer[6]);
//        putvalue(E_pric_Bosch_Radar_RADAR_VARIANT_INFO_VARIANT_INFO_4_Rv,RxDataBuffer[7]);
//        putvalue(E_pric_Bosch_Radar_RADAR_VARIANT_INFO_VARIANT_INFO_5_Rv,RxDataBuffer[8]);
        OSEKTL_SetUseFC(1);
  }
  

  
  if ((RxDataBuffer[0]==0x6e)&(RxDataBuffer[1]==0x48)&(RxDataBuffer[2]==0xf5))
  {
    DirectTxDataLen = 0x3;
    TxDataBuffer[0] = 0x22;
    TxDataBuffer[1] = 0x48;
    TxDataBuffer[2] = 0xf5;
    StartDiagService( DIRECT_RQ );
  }
  
  
    if (RxDataBuffer[0]!=127) // response different than Response Pending
	    {  
              TxLength=0;
        }
     //to save the RxDataBuffer into ErrValue[] for EnvSetReadDTC
    for (i=0;i<rxCount;i++)
        {
            ErrValue[i]=RxDataBuffer[i];
            ltoa(RxDataBuffer[i], MVbuffer2, 16);
            if( strlen( MVbuffer2 ) == 1 )
        		{
        			strncat(buffer2, MVbuffer2, 500);
        			strncat(MVbuffer, buffer2, 500);
        			strncpy(buffer2, "0", 6);
        		}
        		else
        		{
        			strncat(MVbuffer, MVbuffer2, 500);
        		}
        }
    //Convert binary ErrValue[] to string ErrString[]
    FillErrString(rxCount);

    RespTime += timeNow();
    RespTime /= 100;
 write("MVbuffer = %s",MVbuffer); 
    
    //      write("DATA Ind for MPC");		//debugging
            putValue( EnvRespTime_CAN, RespTime);
            putValue( EnvRxData_CAN, RxDataBuffer, rxCount );   
        write("MVBuffer before:%s",MVbuffer);
        putValue(EnvDirectReceive,  MVbuffer);
        write("MVBuffer after:%s",MVbuffer);
	        putValue( EnvRxDataLen_CAN, rxCount );
            getvalue(EnvRxData_CAN,TxDataBuffer);
