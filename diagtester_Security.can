void ascii2hex(char str[], char hexstr[])
{
  dword val;
  int i; 
  
  snprintf(hexstr, elcount(hexstr), "%.2X", str[0]);
  for(i = 1; i < strlen(str); i++)
  {
    snprintf(hexstr, elcount(hexstr), "%s%.2X", hexstr, str[i]);
  }
}

on envVar EnvSendBuffer_1     
{
     if ( getValue (this) )
   {
      DirectTxDataLen = getValue( EnvTxData_1, TxDataBuffer );
    write("DirectTxDataLen = %d",DirectTxDataLen);
      StartDiagService( DIRECT_RQ );
   }
}

///For GEN3 security = below functions are used for sec unlock

void ParseSecurityXML(char nameOfFile[])
{
  
  dword fileHandle;
  char buffer[10000];
  char FileBuffer[150000];
  int filePos;
  int key_type = 0;
  int staticPosStart;
  int staticPosEnd;
  char staticBuffer[50000];
  int seedPosStart;
  int seedPosEnd;
  int staticPos=0;
  int i;
  fileHandle=0;
  strncpy(buffer,"", 10000);
  strncpy(FileBuffer,"", 150000);
  filePos=0;
  key_type = 0;
  staticPosStart=0;
  staticPosEnd=0;
  strncpy(staticBuffer,"", 50000);
  seedPosStart=0;
  seedPosEnd=0;
  staticPos=0;
  i=0;
  write("In PARSE IM");
  write("nameOfFile ---> %s",nameOfFile);
  fileHandle =  openFileRead (nameOfFile,0);
  write("fileHandle=%d",fileHandle);
  while (fileGetStringSZ(buffer,elcount(buffer),fileHandle)!=0)
  {
     //write("In PARSE IM 1");
    
    strncat(FileBuffer, buffer, elcount(FileBuffer));
   // write("FileBuffer=%s",FileBuffer);
  }
  fileClose (fileHandle);
  if(strstr(FileBuffer,"0x61\" key_type=\"static")!=-1)
  {  write("In PARSE IM 2");
    filePos = strstr(FileBuffer,"dia_sub_function=\"0x61\" encrypted=\"no\"");
    if(filePos!=-1)
    {//write("In PARSE IM 3");
      staticPosStart = strstr_off(FileBuffer,filePos,"<SEEDS>")+7;
      staticPosEnd = strstr_off(FileBuffer,filePos,"</KEYS>");
      substr_cpy(staticBuffer, FileBuffer, staticPosStart,staticPosEnd-staticPosStart,elcount(staticBuffer));
	    i=0;
      while(1)
      { //write("In PARSE IM 4 SEED");
        seedPosStart = strstr_off(staticBuffer,staticPos,"<SEED>")+6;
        if(seedPosStart==-1)
        {
          break;
        }
        seedPosEnd = strstr_off(staticBuffer,staticPos+7,"</SEED>");
        if(seedPosEnd==-1)
        {
          break;
        }
        substr_cpy(seedList[i], staticBuffer, seedPosStart+2,seedPosEnd-seedPosStart-2,elcount(seedList));
        i++;
        staticPos = seedPosEnd;
		//  write("seedList[i]len = %d ",elcount(seedList[i]));
      }
      i=0;
	  staticPos = 0;
      while(1)
      { //write("In PARSE IM 5 KEY");
        seedPosStart = strstr_off(staticBuffer,staticPos,"<KEY>")+5;
        if(seedPosStart==-1)
        {
          break;
        }
        seedPosEnd = strstr_off(staticBuffer,staticPos+7,"</KEY>");
        if(seedPosEnd==-1)
        {
          break;
        }
        substr_cpy(keyList[i], staticBuffer, seedPosStart+2,seedPosEnd-seedPosStart-2,elcount(keyList));
        i++;
        staticPos = seedPosEnd;
	//	write("keyList[i] = %x",keyList[i]);
     //   write("keyList[i]len = %d ",elcount(keyList[i]));
      }
    }
    
    securityType = SEEDNKEYFBLREQUEST;
    write("In parse xml_0x61\" key_type=\"static= securityType=%x",securityType);
    write("In parse xml_0x61\" key_type=\"static= SEEDNKEYFBLREQUEST=%x",SEEDNKEYFBLREQUEST);
  }
  else if(strstr(FileBuffer,"0x61\" key_type=\"dynamic")!=-1)
  {
    securityType = SEEDNKEYFBLDYNAMICREQUEST;
    write("In parse xml_0x61\" key_type=\"Dynamic= securityType=%x",securityType);
  }
  else if(strstr(FileBuffer,"0x61\" key_type=\"conventional")!=-1)
  {
    securityType = SEEDNKEYREQUEST;
    write("In parse xml_0x61\" key_type=\"conventional= securityType=%x",securityType);
  }
  else
  {
    write("The Security XML is not as per standards. Conventional mode is active");
  }
  
  //****** For HONDA Security Unlock *******
  if(strstr(FileBuffer,"0x01\" key_type=\"static")!=-1)
  {
    filePos = strstr(FileBuffer,"dia_sub_function=\"0x01\" encrypted=\"no\"");
    if(filePos!=-1)
    {
      staticPosStart = strstr_off(FileBuffer,filePos,"<SEEDS>")+7;
      staticPosEnd = strstr_off(FileBuffer,filePos,"</KEYS>");
      substr_cpy(staticBuffer, FileBuffer, staticPosStart,staticPosEnd-staticPosStart,elcount(staticBuffer));
	    i=0;
      staticPos = 0;
      while(1)
      {
        seedPosStart = strstr_off(staticBuffer,staticPos,"<SEED>")+6;
        if(seedPosStart==-1)
        {
          break;
        }
        seedPosEnd = strstr_off(staticBuffer,staticPos+7,"</SEED>");
        if(seedPosEnd==-1)
        {
          break;
        }
        substr_cpy(seedListHONDA[i], staticBuffer, seedPosStart+2,seedPosEnd-seedPosStart-2,elcount(seedListHONDA));
        i++;
        staticPos = seedPosEnd;
		
      }
      i=0;
	  staticPos = 0;
      while(1)
      {
        seedPosStart = strstr_off(staticBuffer,staticPos,"<KEY>")+5;
        if(seedPosStart==-1)
        {
          break;
        }
        seedPosEnd = strstr_off(staticBuffer,staticPos+7,"</KEY>");
        if(seedPosEnd==-1)
        {
          break;
        }
        substr_cpy(keyListHONDA[i], staticBuffer, seedPosStart+2,seedPosEnd-seedPosStart-2,elcount(keyListHONDA));
        i++;
        staticPos = seedPosEnd;
		
      }
    }
    
    securityTypeHONDA = SEEDNKEYHONDAEOLREQUEST;
    
  }
  else if(strstr(FileBuffer,"0x\01\" key_type=\"dynamic")!=-1)
  {
    securityTypeHONDA = SEEDNKEYHONDADYNAMICREQUEST;
  }
  else if(strstr(FileBuffer,"0x01\" key_type=\"conventional")!=-1)
  {
    securityTypeHONDA = SEEDNKEYHONDAREQUEST;
  }
  else
  {
    write("The Security XML is not as per standards. Conventional mode is active");
  }
  
  Write("securityType == %d and securityTypeHONDA == %d ",securityType,securityTypeHONDA);
  
  
}

MyEvaluateResponse ()
{
	int i;
	int RespLength;

	char buffer[200000];
	char buffer2[200000]="0";

 
	strncpy(buffer2, "0", 6);
	strncpy(MVbuffer2, "",6);
	strncpy(MVbuffer, "",6);

	
		RespLength = ReceiveBufferLength;


	for(i=0; i < ReceiveBufferLength; i++)
	{
		ltoa(ReceiveBuffer[i], MVbuffer2, 16);
		if( strlen( MVbuffer2 ) == 1 )
			{
				strncat(buffer2, MVbuffer2, 200000);
				strncat(MVbuffer, buffer2, 200000);
				strncpy(buffer2, "0", 6);
			}
		else
			{
				strncat(MVbuffer, MVbuffer2, 200000);
			}
	}
  write("MVBuffer in evealution:%s",MVbuffer);
	putValue(EnvDirectReceive,  MVbuffer);
}

void DynamicKeySend()
{
  if(DynamicFlag == 1 ||DynamicFlag == 2)
  {
    cancelTimer(sectimer1);
    cancelTimer(sectimer2);
    putValue(Env_SecurityMode_Output,"Dynamic Security Mode Active");
    dynamicKeyLen = getValue(Env_Security_DynamicInput,DynamicKey);
    sendKey[0]=0x27;
    if(DynamicFlag == 1)
    {
      sendKey[1]=SeednKeyFBLRequest[1]+1;
    }
    else if(DynamicFlag == 2)
    {
      sendKey[1]=SeednKeyHONDAEOLRequest[1]+1;
    }
    k=2;  
    
    strncpy(temp1, "0x",3);
    
    for(j=0;j<dynamicKeyLen;j+=2)
    {
      temp1[2]=DynamicKey[j];
      temp1[3]=DynamicKey[j+1];
      temp1[4]=0;
      sendKey[k]=atol(temp1);
      k++;
     // write("%d",k);
    }
    
    gTxlength = (dynamicKeyLen/2)+2;
    StartDiagService( SEEDNKEYHONDARESP);
    
    
    DynamicFlag = 0;
    putValue(Env_Security_DynamicInput," ");
  }
  
}
