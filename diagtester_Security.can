//Read SW_infor
on envVar EnvReadSwInfo
{
  
  env_SW_Set = 1;
  putValue (EnvDiagSession, 1);
  setTimer(WaitForextendedsession,100);
  putValue (EnvLogInUnlockTypeFour, 1);
  setTimer(WaitForunlock,100);
  
}
on timer WaitForextendedsession
 {
  putvalue(EnvLogInUnlockTypeFour,1);   // step 2: send 27 41 after session is established
}
on timer WaitForunlock
 {
     putValue (EnvLogInUnlockTypeFour, 0);
  
                 ReqDiagMsgGlobal1.dlc = 0x08;
                 ReqDiagMsgGlobal1.byte(0) = 0x03;
                 ReqDiagMsgGlobal1.byte(1) = 0x22;
                 ReqDiagMsgGlobal1.byte(2) = 0xA8;
                 ReqDiagMsgGlobal1.byte(3) = 0xC2;
                 ReqDiagMsgGlobal1.byte(4) = 0x55;
                 ReqDiagMsgGlobal1.byte(5) = 0x55;
                 ReqDiagMsgGlobal1.byte(6) = 0x55;
                 ReqDiagMsgGlobal1.byte(7) = 0x55;
                 output (ReqDiagMsgGlobal1);
   setTimer(WaitForextendedsession,100);
  //getvalue(EnvDirectReceive,a8c2buffer);
   //write("A8C2 data:%s",a8c2buffer);
 
 }

