              KC5_var_2[0] = 0x99;
              KC5_var_2[1] = 0xED;
               
             break;
                case 0xa816:    
              KC5_var_1[0] = 0x9D;
              KC5_var_1[1] = 0x10;

              KC5_var_2[0] = 0x22;
              KC5_var_2[1] = 0xA9;
               
             break;
                 case 0xa817:    
              KC5_var_1[0] = 0x21;
              KC5_var_1[1] = 0x0B;

              KC5_var_2[0] = 0x39;
              KC5_var_2[1] = 0xC1;
               
             break;
             
           }
           
            Temp_KC5[0] = (byte_buf[0]^(KC5_var_1[0]));
            Temp_KC5[1] = (byte_buf[1]^(KC5_var_1[1]));
            write(" Temp_KC5[0] %x  Temp_KC5[1] %x",Temp_KC5[0], Temp_KC5[1]);
            Temp_KC5_2[0] = (Temp_KC5[0]<<2)|(Temp_KC5[1]>>6);
            Temp_KC5_2[1] = (Temp_KC5[1]<<2)|(Temp_KC5[0]>>6);
            write("Temp_KC5_2[0] %x & Temp_KC5_2[1] %x",Temp_KC5_2[0],Temp_KC5_2[1]);


            sum_0 = Temp_KC5_2[1] + KC5_var_2[1];
            write("sum_0 %x",sum_0);
            KeyInByte[1] = sum_0&0xFF;
            write("KeyInByte[0] %x",KeyInByte[0]);
            KeyInByte[0] = Temp_KC5_2[0] + KC5_var_2[0] + (sum_0>>8);
             write("KeyInByte[1] %x",KeyInByte[1]);
      
            resultarrayTypeFive[5]=puffer[5];
            resultarrayTypeFive[4]=puffer[4];             
            resultarrayTypeFive[3]=KeyInByte[1];
            resultarrayTypeFive[2]=KeyInByte[0];
  			    resultarrayTypeFive[1]=0x08;
            resultarrayTypeFive[0]=0x27;
             
            whichlogin=0;
            StartDiagService(SEEDNKEYRESP_TYPE5);

          }

      break;


     case RESET: 
     case START_IR_TEST: 
	 case STOP_IR_TEST: 
     case START_IMG_TEST: 
	 case STOP_IMG_TEST: 
	 case CALIB_AUTO:         
  	 case SKIP_CALIB:
