  SK1 = 0xC0C7;
  SK2 = 0x12B1;  //Series Package04
  SK3 = 0x15D6;
    break;
      
    case 0x04 :      
  SK1 = 0x6D7C;
  SK2 = 0xED2D;  //Series Package05
  SK3 = 0xDBBC;
      
    break;
    
    case 0x05 :
  SK1 = 0x49A3;
  SK2 = 0x52E5;  //Series Package06
  SK3 = 0x1AD7;
      
    break;
      
    case 0x06 :  
  SK1 = 0x4793;
  SK2 = 0x402D;  //Series Package07
  SK3 = 0x1016;
    break;
    
    case 0x7 :  
  SK1 = 0x9E76;
  SK2 = 0x215D;  //Series Package11
  SK3 = 0x4592;
    
    break;
      
    case 0x8 :  
  SK1 = 0xE741;
  SK2 = 0x0E65;  //Series Package21
  SK3 = 0xCF43;
    
    break;
      
    case 0x9 :  
  SK1 = 0x03F2;
  SK2 = 0x90C4;  //Series Package31
  SK3 = 0x51DD;
    break;
      
    case 0xA :
  SK1 = 0x5637;
  SK2 = 0xD08F;  //Series Package32
  SK3 = 0xA9E8;
    break;
      
      case 0xB :  
  SK1 = 0xEB85;
  SK2 = 0x8AD7;  //Series Package33
  SK3 = 0x4B4C;
    
    break;
   
    case 0xC : 
  SK1 = 0x6DB5;
  SK2 = 0xF03A;  //Series Package41
  SK3 = 0xE16C;
    
    break;    
   
  case 0xD :  
  SK1 = 0xE597;
  SK2 = 0xDE77;  //Series Package01_MY24
  SK3 = 0xC152;
    
    break;  
   
   case 0xE :  
      
  SK1 = 0xC21B;
  SK2 = 0x32CE;  //Series Package11_MY24
  SK3 = 0xA152;
    
    break; 
      
       case 0xF :
  SK1 = 0x8C0A;
  SK2 = 0xC9AF;  //Series Package51_MY24
  SK3 = 0x9EE4;
    
    break;
      
      case 0x10 :
  SK1 = 0x59C4;
  SK2 = 0xF79D;  //Series Package21_MY24
  SK3 = 0xEF80;
    
    break;
      
           case 0x11 :
  SK1 = 0x1C92;
  SK2 = 0x3043;  //Series Package61_MY25
  SK3 = 0x9194;
    
    break;
      
           case 0x12 :
  SK1 = 0x3509;
  SK2 = 0xFCBA;  //Series Package62_MY25
  SK3 = 0xF97E;
    
    break;
      
        case 0x13 :
  SK1 = 0x32B7;
  SK2 = 0x0BFE;  //Series Package71_MY25
  SK3 = 0x8FE0;
    
    break;
    
       case 0x14 :
  SK1 = 0x9477;
  SK2 = 0x619C;  //Series Package72_MY25
  SK3 = 0x2537;
    
    break;
      
       case 0x15 :
  SK1 = 0x7924;
  SK2 = 0x9530;  //Series Package81_MY26
  SK3 = 0x56F0;
    
    break;
      case 0x16 :
  SK1 = 0x5C76;
  SK2 = 0x1650;  //Series Package41_MY26
  SK3 = 0x1F1E;
    
    break;
      case 0x17 :
  SK1 = 0x4BDF;
  SK2 = 0x67C6;  //Series Package91_MY26
  SK3 = 0x2A10;
    
    break;
      case 0x18 :
  SK1 = 0xA23C;
  SK2 = 0x6CFF;  //Series Package92_MY26
  SK3 = 0x2E68;

    break;
      case 0x19 :
  SK1 = 0xAF0E;
  SK2 = 0x7B42;  //Series Package93_MY26
  SK3 = 0x3B58;
    
    break;

    case 0x1A:
      SK1 = 0xD507;
      SK2 = 0x144A;  //Series PackageA0_MY28
      SK3 = 0x19BB;
    break;

    case 0x1B:
      SK1 = 0x0310;
      SK2 = 0x6100;  //Series PackageA1_MY28
      SK3 = 0x24C1;
    break;

    case 0x1C:
      SK1 = 0x2E22;
      SK2 = 0x503C;  //Series PackageA2_MY28
      SK3 = 0x1925;
    break;

    case 0x1D:
      SK1 = 0x0131;
      SK2 = 0x6B61;  //Series PackageA3_MY28
      SK3 = 0x2D0A;
    break;

  default :
     
      write("Default for the unknown packages");
  SK1 = 0x1111;
  SK2 = 0x2222;  //Default Package
  SK3 = 0x3333;
   break; 
  }

  
    if ( getValue (this) )
   {
     whichlogin=4;

  
  
   
     StartDiagService( SEEDNKEYREQUESTUNLOCKONE );
     //putvalue(EnvRBEOL,0); // Reset Value for next use
  
    }
   
}


