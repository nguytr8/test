      case SEEDNKEYHONDADYNAMICREQUEST:
        
            responseLen = getvalue(EnvRxData_CAN,securityRespBuffer);
            for(i=0;i<responseLen;i++)
            {
              ltoa(securityRespBuffer[i],IMBuffer,16);
              if( strlen( IMBuffer ) == 1 )
