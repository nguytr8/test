Display_DTC_MID_Name (dword error)
{

switch(error)
    {
	case 0xC41568:
        putValue (EnvDtcName_Display, "DTC_ABS_FAILURE");
		putValue (EnvMidName, "C_MID_FAULT_ABS_FAILURE_N");
	break;

    case 0x5BDC00:
        putValue (EnvDtcName_Display, "DTC_ACCEL_PEDAL_FAILURE");
		putValue (EnvMidName, "C_MID_FAULT_ACCEL_PEDAL_FAILURE_N");
	break;
    	
	case 0xD28000:
        putValue (EnvDtcName_Display, "DTC_BCAN_COMBI_FAILURE");
		putValue (EnvMidName, "C_MID_FAULT_BCAN_COMBI_FAILURE_N");
	break;
	
	case 0xD28100:
        putValue (EnvDtcName_Display, "DTC_BCAN_MICU_FAILURE");
