on timer Wait_diag
{
  //Update for MaxHold Resim My28
  DiagSession = 0;                        // reset guard so session request is always sent
  putvalue(EnvDiagSession,1);             // step 1: send 10 03 (extended session)
  putvalue(EnvLogInUnlockTypeFour,0);     // reset so handler fires reliably in step 2
  setTimer(WaitForextendedsession,50);   // step 2: fire unlock after 100 ms delay
}
on timer Wait_on
{  
  // IP Toellner control
  sysExec("C:\\FSI\\FSI.exe","-c power -cmd on");
  setTimer(Wait_diag,1000);  
  igResetIndex++;
  if (igResetIndex < igResetEventCount)
  {
    setTimer(Wait_off, (long)(igOffDelayMs[igResetIndex] + 0.5));
  }
  }
  
on timer Wait_off
  { 
  // IP Toellner control
  sysExec("C:\\FSI\\FSI.exe","-c power -cmd off");
  putvalue(EnvDiagSession,0);
//  setTimer(Wait_on, 4007.228); //#2_100k
//  setTimer(Wait_on, 4006.401); //#2_130km
//  setTimer(Wait_on, 3205.828); //#7_1_N1    
//  setTimer(Wait_on, 3205.679); //#7_1_N3
//  setTimer(Wait_on, 3305.42);  //#7_2_N1
//  setTimer(Wait_on, 3207.327); //#7_2_N2
//  setTimer(Wait_on, 3406.327); //#7_2_N3
//  setTimer(Wait_on, 3304.808); //#7_4_N1
//  setTimer(Wait_on, 3306.24);  //#8_1_N3
  if (igResetIndex < igResetEventCount)
  {
    setTimer(Wait_on, (long)(igOnDelayMs[igResetIndex] + 0.5));
  }
//  setTimer(Wait_on, 3303.882); //#8_2_N2
//  setTimer(Wait_on, 3806.494); //#8_2_N3
//  setTimer(Wait_on, 4308.124); //#9_1
